{
  "name": "sm-erp-api",
  "version": "0.1.0",
  "private": true,
  "description": "SM ERP backend — auth, RBAC and finance APIs",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js --status",
    "test": "node --test test/*.test.js",
    "job:fee-reminders": "node scripts/run-fee-reminders.js",
    "platform:admin": "node scripts/create-platform-admin.js",
    "release": "node scripts/migrate.js && node scripts/seed-demo.js && node scripts/seed-demo-extras.js && node scripts/seed-demo-modules.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^7.0.13",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.3.0",
    "zod": "^3.24.1"
  }
}
