# Local development defaults. In production (Railway) NODE_ENV=production is enforced:
# the image sets it, and the app refuses to boot in Railway's production environment without it.
NODE_ENV=development
PORT=4000

# Railway: reference the Postgres service, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://user:password@localhost:5432/sm_erp
# disable | no-verify | verify   (Railway private network: disable; Railway public proxy: no-verify)
DATABASE_SSL=disable
# Connections per process (replicas x DB_POOL_MAX must stay well under Postgres max_connections = 100)
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000

# ---- Cache + shared rate limits. Railway: ${{Redis.REDIS_URL}}. Leave empty for in-memory (single replica only).
REDIS_URL=
CACHE_ENABLED=true

# ---- Rate limits
RATE_LIMIT_LOGIN_PER_IP=30
RATE_LIMIT_LOGIN_PER_ACCOUNT=10
RATE_LIMIT_API_PER_MIN=1200
RATE_LIMIT_PDF_PER_MIN=30

# ---- Logging (JSON lines on stdout; Railway parses them)
LOG_LEVEL=info
ACCESS_LOG=true

# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"   (production: 48+ chars)
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_ISSUER=sm-erp-api
JWT_AUDIENCE=sm-erp-clients
REFRESH_TOKEN_TTL_DAYS=30

MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Number of proxy hops in front of the app (Railway = 1)
TRUST_PROXY=1

# ---- Notifications (SMS / WhatsApp)
# simulated | twilio | msg91 | none        (simulated = log only, nothing is sent)
NOTIFY_SMS_PROVIDER=simulated
# none | twilio | simulated
NOTIFY_WHATSAPP_PROVIDER=none
# Channels tried in order; a channel without a provider is skipped
NOTIFY_CHANNEL_ORDER=whatsapp,sms
NOTIFY_SCHOOL_NAME=DPS Dwarka
NOTIFY_MAX_ATTEMPTS=3
NOTIFY_TIMEOUT_MS=10000

# Twilio (SMS and/or WhatsApp). WhatsApp needs Meta-approved Content templates (HX... SIDs).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SID_ABSENTEE=
TWILIO_CONTENT_SID_FEE_DUE=
TWILIO_CONTENT_SID_NOTICE=
TWILIO_CONTENT_SID_ATTENDANCE_CORRECTION=

# MSG91 (India, SMS). One Flow per message, each linked to a DLT-registered template.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_FLOW_ABSENTEE=
MSG91_FLOW_FEE_DUE=
MSG91_FLOW_NOTICE=
MSG91_FLOW_ATTENDANCE_CORRECTION=

# WATI (WhatsApp Business API). Set NOTIFY_WHATSAPP_PROVIDER=wati
WATI_API_ENDPOINT=
WATI_ACCESS_TOKEN=
WATI_CHANNEL_NUMBER=
# Approved template names, if different from the defaults in providers/wati.provider.js
WATI_TEMPLATE_ABSENTEE=
WATI_TEMPLATE_FEE_DUE=
WATI_TEMPLATE_NOTICE=
WATI_TEMPLATE_ATTENDANCE_CORRECTION=

# Payment links in fee reminders point here (https)
PARENT_PORTAL_URL=
# How often the retry worker checks notification_logs for failed messages
NOTIFY_RETRY_INTERVAL_MS=60000

# ---- Online fee payments (Razorpay). Leave all three empty to disable online payment.
# Dashboard -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks -> Add: URL https://<api-host>/api/v1/finance/webhook,
# events payment.captured (+ order.paid). This secret is the one you type there, not the key secret.
RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_API_BASE=https://api.razorpay.com
# Minutes a created order is offered to the parent before the app asks for a new one
PAYMENT_ORDER_TTL_MINUTES=30

# ---- Official documents: base URL printed in QR codes on report cards / TC / bonafide.
# Point it at a web page that calls GET /api/v1/verify/:code (defaults to the API's JSON endpoint).
DOCUMENT_VERIFY_BASE_URL=
